    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-testing-library": "^7.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.5.3",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.5",
    "storybook": "8.6.12",
    "stylelint": "16.18.0",
    "stylelint-config-clean-order": "7.0.0",
    "stylelint-config-standard-scss": "14.0.0",
    "ts-node": "^10.9.2",
