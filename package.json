{
  "name": "inctagram-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "yarn build",
    "start": "next start",
    "format": "prettier --write src",
    "lint": "eslint src --ext .jsx,.js,.tsx,.ts  --no-error-on-unmatched-pattern --fix && stylelint --fix src/{,*/}*.{scss,css} --allow-empty-input",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-icons": "npx @svgr/cli --out-dir src/components/icons  --jsx-runtime automatic --typescript --ref --memo --replace-attr-values '#000=currentColor' --replace-attr-values '#fff=currentColor' -- public/add-post"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/roboto": "^5.2.5",
